# SyncGuard environment — placeholders only, never real credentials.
APP_NAME=SyncGuard
APP_VERSION=0.1.0
DEBUG=false
# development | production. Production refuses to start on placeholder SECRET_KEY.
ENV=development
# Application-level API key (X-API-Key header). Unset = development-open mode.
API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syncguard
REDIS_URL=redis://localhost:6379/0
# REQUIRED in production: long random value, e.g. openssl rand -hex 32
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_UPLOAD_SIZE_MB=10
DEMO_MODE=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
LOG_LEVEL=INFO
CORS_ORIGINS=*
# Controlled external PostgreSQL target for real write validation (Phases 6B/6C).
# Format: postgresql://USER@HOST:PORT/syncguard_target (no password for local trust auth).
SYNCGUARD_PG_TARGET=
