# Supabase/external-PostgreSQL validation placeholders ONLY.
# Copy to an untracked location (or export directly) and fill in real values.
# NEVER commit real credentials. This file must stay placeholder-only.
#
# Usage:
#   DATABASE_URL='postgresql://postgres:<db-password>@<project-ref>.supabase.co:5432/postgres?sslmode=require' \
#   SECRET_KEY='<strong-random-value>' \
#   API_KEY='<strong-random-value>' \
#   docker compose -f docker-compose.yml -f docker-compose.supabase.yml up backend

DATABASE_URL=postgresql://postgres:PASTE_DB_PASSWORD_HERE@PASTE_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SECRET_KEY=PASTE_STRONG_RANDOM_VALUE_HERE
API_KEY=PASTE_STRONG_RANDOM_VALUE_HERE
ENV=production
PORT=8000
CORS_ORIGINS=*
